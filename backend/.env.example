# ═══════════════════════════════════════════
# WPProServices — Backend Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════

# ─── Server ──────────────────────────────
PORT=5002

# ─── Database (MySQL) ────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=wpservices_agency
DB_PORT=3306
DB_SSL=false

# ─── Authentication ──────────────────────
# Generate a strong random string (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_64_char_random_string

# ─── Default Admin Account ───────────────
# Used by the seed script to create the first admin user.
# Change these BEFORE running the seed for the first time.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ─── Frontend URL (CORS) ─────────────────
# Comma-separated list of allowed origins.
# Example: https://wpproservices.com,https://www.wpproservices.com
FRONTEND_URL=https://wpproservices.com
