# ═══════════════════════════════════════════
# WPProServices — Frontend Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env.production and fill in your values:
#   cp .env.example .env.production
#
# For local development, copy to .env.development:
#   cp .env.example .env.development
# ═══════════════════════════════════════════

# ─── API URL ─────────────────────────────
# The full URL to the backend API (without trailing slash).
# Production example: https://api.wpproservices.com
# Dev example:        http://localhost:5002
#
# If left empty, the frontend uses Vite's proxy (/api → localhost:5002).
VITE_API_URL=https://api.wpproservices.com
